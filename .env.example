# EEN test credentials for E2E testing
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# TEST_USER and TEST_PASSWORD are required for running E2E tests.
# CLIENT_ID defaults to PREVIEW-KLAUS-MOBILE if not set.
# PROXY_URL defaults to http://127.0.0.1:3333 if not set.

TEST_USER="your-email@example.com"
TEST_PASSWORD="your-password"
CLIENT_ID="PREVIEW-KLAUS-MOBILE"
# PROXY_URL="http://127.0.0.1:3333"
