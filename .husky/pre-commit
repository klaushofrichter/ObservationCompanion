#!/usr/bin/env bash

# Bump patch version in package.json and regenerate Version.swift
# This runs before every commit so the version stays in sync.

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT_DIR"

# Read current version
CURRENT_VERSION=$(node -p "require('./package.json').version")
IFS='.' read -r MAJOR MINOR PATCH <<< "$CURRENT_VERSION"
NEW_PATCH=$((PATCH + 1))
NEW_VERSION="$MAJOR.$MINOR.$NEW_PATCH"

# Bump version in package.json (without npm to avoid hooks loop)
node -e "
const fs = require('fs');
const pkg = JSON.parse(fs.readFileSync('package.json', 'utf8'));
pkg.version = '$NEW_VERSION';
fs.writeFileSync('package.json', JSON.stringify(pkg, null, 2) + '\n');
"

# Generate Version.swift
"$ROOT_DIR/scripts/generate-version.sh"

# Stage the changed files
git add package.json
git add ObservationCompanion/Version.swift
